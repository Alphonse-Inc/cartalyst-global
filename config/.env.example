# Copy this file to config/.env and fill in real values.
# Never commit .env or upload it to a public repository.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://cartalystglobal.com
APP_KEY=replace-with-a-long-random-string
APP_NAME="Cartalyst Global"

# Canonical host without protocol. Used in SEO tags and (with .htaccess) redirects.
CANONICAL_HOST=cartalystglobal.com
FORCE_HTTPS=true
# www | apex  — keep in sync with public/.htaccess rewrite rules
CANONICAL_STYLE=apex

DB_HOST=localhost
DB_NAME=cartalyst_global
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@cartalystglobal.com
SMTP_FROM_NAME="Cartalyst Global"

PROCUREMENT_TO_EMAIL=procurement@cartalystglobal.com
CONTACT_TO_EMAIL=hello@cartalystglobal.com
REVIEWS_TO_EMAIL=hello@cartalystglobal.com

# turnstile | recaptcha | none
CAPTCHA_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Search Console HTML tag content, e.g. abcdef123
GSC_VERIFICATION=
BING_VERIFICATION=
